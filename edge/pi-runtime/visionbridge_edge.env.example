MODEL_PATH=/opt/visionbridge/models/best_256.onnx
VISIONBRIDGE_CLOUD_URL=https://your-domain.example/api/v1/telemetry
VISIONBRIDGE_INGEST_TOKEN=replace-with-random-ingest-token
VISIONBRIDGE_GATEWAY_ID=visionbridge-gateway-01
VISIONBRIDGE_DEVICE_ID=visionbridge-edge-01
VISIONBRIDGE_CLOUD_TIMEOUT_SEC=12
VISIONBRIDGE_CLOUD_QUEUE_SIZE=128
VISIONBRIDGE_MAX_SNAPSHOT_BYTES=4194304
HEARTBEAT_INTERVAL=5
SNAPSHOTS_DIR=/var/lib/visionbridge/snapshots
WEB_PREVIEW_ENABLE=1
WEB_PREVIEW_HOST=127.0.0.1
WEB_PREVIEW_PORT=8090
INPUT_SIZE=256
INFER_EVERY_N_FRAMES=1
# Zero starts the next inference as soon as the previous one completes.
INFER_INTERVAL_SEC=0
CONFIRM_WINDOW_FRAMES=8
CONFIRM_REQUIRED_HITS=5
CONFIRM_MIN_DURATION_SEC=2
CLEAR_MISS_FRAMES=5
CLEAR_DURATION_SEC=3
EVIDENCE_INTERVAL_SEC=30
EVENT_COOLDOWN_SEC=20
SPATIAL_DEDUP_METERS=15
CAMERA_WIDTH=320
CAMERA_HEIGHT=240
CAMERA_TARGET_FPS=15
WEB_PREVIEW_FPS=15
WEB_PREVIEW_JPEG_FPS=5
WEB_PREVIEW_QUALITY=70

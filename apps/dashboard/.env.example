VISIONBRIDGE_INGEST_TOKEN=replace-with-random-ingest-token
VISIONBRIDGE_AUTH_SECRET=replace-with-at-least-32-random-characters
VISIONBRIDGE_DEFAULT_LNG=121.434412
VISIONBRIDGE_DEFAULT_LAT=28.629306
AMAP_JS_KEY=replace-with-amap-js-key
AMAP_SECURITY_CODE=replace-with-amap-security-code
VISIONBRIDGE_SMTP_HOST=smtp.qq.com
VISIONBRIDGE_SMTP_PORT=465
VISIONBRIDGE_SMTP_USER=your-account@qq.com
VISIONBRIDGE_SMTP_AUTH_CODE=replace-with-smtp-auth-code
VISIONBRIDGE_SMTP_FROM_NAME=视桥志愿者平台
VISIONBRIDGE_EMAIL_DEBUG=false
# Optional asynchronous data-cleaning provider. Prefer the Advantech gateway;
# direct Dify is a standards-compatible fallback. Keep secrets server-side.
VISIONBRIDGE_ADVANTECH_AGENT_URL=
VISIONBRIDGE_ADVANTECH_AGENT_KEY=
VISIONBRIDGE_ADVANTECH_WORKFLOW=visionbridge-data-cleaning
VISIONBRIDGE_ADVANTECH_DIFY_API_BASE=
VISIONBRIDGE_ADVANTECH_DIFY_API_KEY=
VISIONBRIDGE_DIFY_API_BASE=
VISIONBRIDGE_DIFY_API_KEY=
VISIONBRIDGE_DIFY_WORKFLOW=visionbridge-data-cleaning
VISIONBRIDGE_ANALYSIS_TIMEOUT_SEC=25

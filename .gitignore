# Local workspaces and private archives
.trae/
.idea/
.vscode/
**/.openai/
**/.git-empty-backup/
90_历史版本与过程文件/
99_私密配置_禁止提交/

# Secrets and machine-specific configuration
**/.env
**/.env.*
!**/.env.example
!**/*.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/local.properties

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/.venv/
**/venv/
**/*.egg-info/

# Node.js and web builds
**/node_modules/
**/.npm-cache/
.firecrawl/
**/.next/
**/dist/
**/static-deploy/
**/.wrangler/
**/*.tsbuildinfo

# Flutter, Dart and Gradle builds
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.gradle/
**/build/
**/*.apk
**/*.aab

# Runtime data and user-generated content
**/data-local-preview/
**/data/
**/uploads/
**/volunteer_uploads/
**/snapshots/
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.pid
**/*.log

# Binary deliverables and model weights belong in GitHub Releases/object storage
**/*.onnx
**/*.tflite
**/*.engine
**/*.pt
**/*.pth
**/release-staging-*/
**/*.tar.gz
**/*.tgz
**/*.zip

# Office source files are local unless explicitly approved for publication
**/*.pptx
**/*.docx

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
